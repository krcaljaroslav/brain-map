{
  "name": "brain-map",
  "version": "0.2.1",
  "description": "Mind map of your vault, drawn like a neural network: folders as branches, notes as leaves, links between them.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validace": "bash tests/validace-a3.sh",
    "lint": "eslint ."
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "20.19.41",
    "esbuild": "0.21.5",
    "obsidian": "1.13.1",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.72.0",
    "eslint-plugin-obsidianmd": "0.4.2"
  },
  "engines": {
    "node": ">=18"
  }
}
